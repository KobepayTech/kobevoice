# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Speech-to-text — https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Text-to-speech provider: "cartesia" (default) or "fish"
KOBEVOICE_TTS=cartesia

# TTS option 1 — Cartesia. https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# TTS option 2 — Fish Audio's HOSTED API. https://fish.audio/go-api/
# This is the commercial SaaS, NOT the self-hosted fish-speech weights
# (those are under a non-commercial research licence — see README).
FISH_API_KEY=
FISH_VOICE_ID=

# Optional overrides
# Voice latency is dominated by the LLM. Switch to claude-sonnet-5 if replies
# feel slow; keep claude-opus-5 when answer quality matters more.
# KOBEVOICE_LLM_MODEL=claude-opus-5
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
