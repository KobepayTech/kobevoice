LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TTS backend: "inference" (LiveKit hosted gateway, default) or "chatterbox" (self-hosted)
KOBEVOICE_TTS=inference

# Chatterbox only — requires: uv pip install -e ".[chatterbox]"
# Path to a ~10s reference clip to clone. Omit for the model's default voice.
CHATTERBOX_VOICE_SAMPLE=
# "cuda" (default), "mps", or "cpu". CPU measured at RTF ~12-24 — unusable for live calls.
CHATTERBOX_DEVICE=cuda

# ---------------------------------------------------------------------------
# Stack profile: "hosted" (default) or "local"
#
#   hosted — LiveKit Inference gateway. Needs LIVEKIT_API_KEY, bills per use.
#   local  — every model on your own hardware, no per-use vendor billing.
#            Requires a GPU. See the cost section in the README.
# ---------------------------------------------------------------------------
KOBEVOICE_STACK=hosted

# Per-component overrides. LLM also supports "kobeai".
# KOBEVOICE_STT=local
# KOBEVOICE_LLM=kobeai
# KOBEVOICE_TTS=local

# KobeAI routing. If KOBEAI_BASE_URL is set, the LLM stage automatically uses
# KobeAI's /api/v1/voice/openai Chat Completions bridge instead of direct
# Ollama/LiveKit inference. KOBEAI_VOICE_SECRET must match
# KOBEVOICE_SHARED_SECRET on the KobeAI API server.
# KOBEAI_BASE_URL=http://localhost:5000
# KOBEAI_VOICE_SECRET=replace-with-a-long-random-secret
# KOBEAI_ROUTER_MODEL=kobeai-router

# Local stack endpoints (defaults suit docker-compose.local.yml)
# LOCAL_STT_URL=http://localhost:8001/v1
# LOCAL_STT_MODEL=Systran/faster-whisper-small
# LOCAL_LLM_URL=http://localhost:11434/v1
# Apache-2.0. Check the licence before swapping — Llama restricts use above
# 700M monthly active users.
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct

# Conversation language (ISO code). Drives STT and TTS together.
# Chatterbox multilingual covers 23 languages incl. Swahili ("sw").
KOBEVOICE_LANGUAGE=en
