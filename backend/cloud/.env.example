# Kobevoice Cloud control-plane configuration.
# Copy to `.env` and fill in. All vars are prefixed KOBEVOICE_CLOUD_.

# --- Core ---
KOBEVOICE_CLOUD_DATABASE_URL=sqlite:///./data/cloud.db
# Production example:
# KOBEVOICE_CLOUD_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/kobevoice
KOBEVOICE_CLOUD_FRONTEND_URL=http://localhost:5173
KOBEVOICE_CLOUD_ENVIRONMENT=development

# --- Auth (CHANGE THE SECRET IN PRODUCTION) ---
KOBEVOICE_CLOUD_JWT_SECRET=change-me-to-a-long-random-string
KOBEVOICE_CLOUD_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Seed admin (internal studio backoffice operator) ---
KOBEVOICE_CLOUD_ADMIN_EMAIL=admin@kobevoice.app
KOBEVOICE_CLOUD_ADMIN_PASSWORD=change-me

# --- Voice engine (the stateless /synthesize worker to proxy to) ---
# Dev: the bundled lite engine (uvicorn backend.engine_lite.main:app --port 8000)
# Prod: your Qwen/Whisper engine exposing the same /synthesize contract.
KOBEVOICE_CLOUD_ENGINE_URL=http://127.0.0.1:8000
# Where per-user generated audio is stored (swap for S3/R2 in production).
KOBEVOICE_CLOUD_AUDIO_DIR=./data/cloud_audio

# --- Stripe (leave blank to run with billing disabled) ---
KOBEVOICE_CLOUD_STRIPE_SECRET_KEY=
KOBEVOICE_CLOUD_STRIPE_WEBHOOK_SECRET=
KOBEVOICE_CLOUD_STRIPE_PRICE_CLOUD=
KOBEVOICE_CLOUD_STRIPE_PRICE_PRO=
# Dev only: simulate successful checkout locally (no Stripe). Never in prod.
KOBEVOICE_CLOUD_BILLING_DEV_MODE=false
